  46:Core/Src/main.c **** 
  47:Core/Src/main.c ****     /* Initialize the HAL Library */
  48:Core/Src/main.c ****     HAL_Init();
  49:Core/Src/main.c **** 
  50:Core/Src/main.c ****     /* Configure the system clock */
  51:Core/Src/main.c ****     SystemClock_Config();
  52:Core/Src/main.c **** 
  53:Core/Src/main.c ****     /* Initialize GPIOs */
  54:Core/Src/main.c ****     MX_GPIO_Init();
  55:Core/Src/main.c **** 
  56:Core/Src/main.c ****     /* Turn on LED0 to signal start */
  57:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
  58:Core/Src/main.c ****     HAL_Delay(2000);
  59:Core/Src/main.c **** 
  60:Core/Src/main.c ****     /* Initialize DWT cycle counter */
  61:Core/Src/main.c ****     DWT_init();
  62:Core/Src/main.c **** 
  63:Core/Src/main.c ****     /* Run Mandelbrot for each image size */
  64:Core/Src/main.c ****     for (int i = 0; i < numSizes; i++) {
  65:Core/Src/main.c ****         int size = sizes[i];
  66:Core/Src/main.c **** 
  67:Core/Src/main.c ****         /* Reset DWT counter */
  68:Core/Src/main.c ****         DWT->CYCCNT = 0;
  69:Core/Src/main.c ****         uint32_t startCycle = DWT->CYCCNT;
  70:Core/Src/main.c ****         uint32_t startTime = HAL_GetTick();
  71:Core/Src/main.c **** 
  72:Core/Src/main.c ****         uint64_t checksum = Calculate_double_Mandelbrot(size, size, maxIter);
  73:Core/Src/main.c **** 
  74:Core/Src/main.c ****         uint32_t endTime = HAL_GetTick();
  75:Core/Src/main.c ****         uint32_t endCycle = DWT->CYCCNT;
  76:Core/Src/main.c **** 
  77:Core/Src/main.c ****         elapsed_Time = endTime - startTime;
  78:Core/Src/main.c ****         elapsed_Cycles = endCycle - startCycle;
  79:Core/Src/main.c **** 
  80:Core/Src/main.c ****         uint64_t totalPixels = (uint64_t)size * (uint64_t)size;
  81:Core/Src/main.c ****         uint64_t throughput = 0;
  82:Core/Src/main.c ****         if (elapsed_Time > 0) {
  83:Core/Src/main.c ****             throughput = (totalPixels * 1000ULL) / elapsed_Time; // pixels per second
  84:Core/Src/main.c ****         }
  85:Core/Src/main.c **** 
  86:Core/Src/main.c ****         /* Print results */
  87:Core/Src/main.c ****         printf("Image Size: %dx%d\n", size, size);
  88:Core/Src/main.c ****         printf("Checksum = %llu\n", (unsigned long long)checksum);
