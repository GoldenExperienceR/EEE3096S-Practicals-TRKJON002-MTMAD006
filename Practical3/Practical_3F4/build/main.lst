 109:Core/Src/main.c **** /* Mandelbrot calculation using double precision */
 110:Core/Src/main.c **** uint64_t Calculate_double_Mandelbrot(int width, int height, int maxIter)
 111:Core/Src/main.c **** {
 112:Core/Src/main.c ****     uint64_t checksum = 0;
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     for (int y = 0; y < height; y++) {
 115:Core/Src/main.c ****         for (int x = 0; x < width; x++) {
 116:Core/Src/main.c ****             double x0 = ((double)x / (double)width) * 3.5 - 2.5;
 117:Core/Src/main.c ****             double y0 = ((double)y / (double)height) * 2.0 - 1.0;
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****             double xi = 0.0, yi = 0.0;
 120:Core/Src/main.c ****             int iteration = 0;
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****             while (iteration < maxIter && (xi*xi + yi*yi) <= 4.0) {
 123:Core/Src/main.c ****                 double tmp = xi*xi - yi*yi;
 124:Core/Src/main.c ****                 yi = 2.0*xi*yi + y0;
 125:Core/Src/main.c ****                 xi = tmp + x0;
 126:Core/Src/main.c ****                 iteration++;
 127:Core/Src/main.c ****             }
 128:Core/Src/main.c **** 
 129:Core/Src/main.c ****             checksum += (uint64_t)iteration;
 130:Core/Src/main.c ****         }
 131:Core/Src/main.c ****     }
 132:Core/Src/main.c **** 
 133:Core/Src/main.c ****     return checksum;
 134:Core/Src/main.c **** }
 135:Core/Src/main.c **** 
 136:Core/Src/main.c **** /* DWT initialization for cycle counting */
 137:Core/Src/main.c **** static inline void DWT_init(void)
 138:Core/Src/main.c **** {
 139:Core/Src/main.c ****     CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
 140:Core/Src/main.c ****     #if defined(DWT_LAR)
 141:Core/Src/main.c ****         DWT->LAR = 0xC5ACCE55; // unlock if needed
 142:Core/Src/main.c ****     #endif
 143:Core/Src/main.c ****     DWT->CYCCNT = 0;
 144:Core/Src/main.c ****     DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
 145:Core/Src/main.c **** }
